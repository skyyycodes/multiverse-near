{
  "name": "ifverse-scripts",
  "version": "0.1.0",
  "private": true,
  "description": "IfVerse on NEAR: accounts, deployment, upgrade and rehearsal, seeding, resolution, bots, soak and end-to-end tooling",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build:wasm": "bash build-wasm.sh",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "test:live": "FRED_LIVE=1 node --import tsx --test lib/fred.test.ts",
    "accounts": "tsx accounts.ts",
    "deploy:contract": "tsx deploy.ts",
    "sandbox": "tsx sandbox.ts",
    "seed": "tsx seed-demo.ts",
    "demo-sale": "tsx demo-sale.ts",
    "reset": "tsx reset.ts",
    "resolver": "tsx resolver.ts",
    "e2e": "tsx e2e.ts",
    "outlayer": "tsx outlayer.ts",
    "upgrade": "tsx upgrade.ts",
    "rehearse": "tsx rehearse.ts",
    "release": "tsx release.ts",
    "reclaim": "tsx reclaim.ts",
    "ops": "tsx ops.ts",
    "watch": "tsx watch.ts",
    "reference": "tsx reference.ts",
    "seed:v2": "tsx seed-v2.ts",
    "maker": "tsx maker.ts",
    "market": "tsx market.ts",
    "liquidator": "tsx liquidator.ts",
    "soak": "tsx soak.ts",
    "measure": "tsx measure.ts",
    "accept": "tsx accept.ts"
  },
  "dependencies": {
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
