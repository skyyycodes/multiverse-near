# Which deployment the build reads: deployments/<network>.json at the repo root (testnet | staging | sandbox | rehearsal).
# Staging when unset. Contract, token ids, RPC and explorer come from that file; a value set here wins over it.
NEXT_PUBLIC_NETWORK=staging
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.near.org
# NEXT_PUBLIC_RPC_URLS=https://rpc.testnet.near.org,https://rpc.testnet.fastnear.com   # tried in order
# 1 adds the demo-wallet bridge (test keys, driven by Playwright); build:staging sets it. Real visitors never have it.
NEXT_PUBLIC_DEMO_WALLET=0
# NEAR Intents (1Click), read by the model's deposit quotes until that element is removed. Quotes are dry runs only.
NEXT_PUBLIC_ONECLICK_JWT=
NEXT_PUBLIC_INTENTS_RECIPIENT=demo.near
