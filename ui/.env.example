# Leave the contract ids empty to run on the in-browser model.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.near.org
NEXT_PUBLIC_CORE_CONTRACT=
NEXT_PUBLIC_RESOLVER_CONTRACT=
NEXT_PUBLIC_USDC_CONTRACT=
NEXT_PUBLIC_WNEAR_CONTRACT=
