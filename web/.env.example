# Which deployment to read (deployments/<network>.json): testnet or sandbox. next.config.ts fills the contract, token
# ids, RPC and explorer from that file; any of them set here wins.
NEXT_PUBLIC_NETWORK=testnet
# NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
# NEXT_PUBLIC_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.fastnear.com,https://near-testnet.drpc.org
# NEXT_PUBLIC_CONTRACT_ID=app.multiverse-near.testnet
# NEXT_PUBLIC_EXPLORER=https://testnet.nearblocks.io
# What the Admin screen tells the operator to run to reset the demo.
NEXT_PUBLIC_RESET_COMMAND="RUN_SALE=false pnpm -C scripts reset"
# Design mode: serve snapshot data built from the seeded demo numbers instead of reading the chain.
# NEXT_PUBLIC_FIXTURES=1
# Accept the test-key wallet the recorder and the end-to-end runs inject. Never for a public build.
# NEXT_PUBLIC_DEMO_WALLET=1
NEXT_TELEMETRY_DISABLED=1
