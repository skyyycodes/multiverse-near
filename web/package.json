{
  "name": "multiverse-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web app for Multiverse Lending on NEAR: sell NEAR only in the futures you fear, borrow against the worst one.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3040",
    "dev:sandbox": "NEXT_PUBLIC_NETWORK=sandbox NEXT_PUBLIC_DEMO_WALLET=1 next dev --port 3040",
    "dev:fixtures": "NEXT_PUBLIC_NETWORK=testnet NEXT_PUBLIC_FIXTURES=1 next dev --port 3040",
    "network": "node scripts/network.mjs",
    "build": "next build",
    "build:fixtures": "NEXT_PUBLIC_NETWORK=testnet NEXT_PUBLIC_FIXTURES=1 next build && rm -rf out-fixtures && mv out out-fixtures",
    "build:live": "NEXT_PUBLIC_NETWORK=sandbox NEXT_PUBLIC_DEMO_WALLET=1 next build && rm -rf out-live && mv out out-live",
    "build:demo": "NEXT_PUBLIC_NETWORK=testnet NEXT_PUBLIC_DEMO_WALLET=1 next build && rm -rf out-demo && mv out out-demo",
    "serve": "node scripts/serve.mjs out 3040",
    "serve:fixtures": "node scripts/serve.mjs out-fixtures 3041",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:live": "LIVE=1 playwright test",
    "shots": "node scripts/shots.mjs http://localhost:3041"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@tanstack/react-query": "^5.107.1",
    "framer-motion": "^14.12.0",
    "near-api-js": "7.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.28.0"
}
